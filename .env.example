# Copy to .env and fill in. .env is gitignored.

BASE_URL=https://www.parlaysyndicate.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_PATH=./data/parlay.duckdb

# --- Email (magic-link logins and syndicate invites) ---
# console = write links to logs + data/outbox/ (default, no signup needed)
# resend  = set RESEND_API_KEY
# smtp    = set SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD
EMAIL_PROVIDER=console
EMAIL_FROM=Parlay Syndicate <noreply@parlaysyndicate.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS ("the picks are in!" texts) ---
# ROTATE the old key before enabling: the previous one is in public git history.
SMS_ENABLED=false
TEXTBELT_KEY=

# --- Scheduler (UTC hours) ---
SCHEDULER_ENABLED=true
GRADE_CRON_HOUR=11
SYNC_CRON_HOUR=12

CURRENT_SEASON=2026
