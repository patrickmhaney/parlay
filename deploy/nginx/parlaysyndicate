# Parlay Syndicate -- installed as /etc/nginx/sites-available/parlaysyndicate
#
# Same shape as the haneytube block: Cloudflare terminates TLS and talks to
# this box over plain HTTP on :80; nginx routes by hostname.

# Cloudflare connects over http but tells us the visitor used https. Pass
# *that* through, or the app builds http:// URLs inside an https page and the
# browser blocks the CSS and every HTMX request as mixed content.
map $http_x_forwarded_proto $parlay_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    # The Cloudflare zone for this domain has an origin rule sending traffic to
    # port 8080 (left over from when uvicorn listened there directly). Answer
    # on it too, so the site works whether or not that rule is ever removed.
    listen 8080;
    server_name parlaysyndicate.com www.parlaysyndicate.com;

    client_max_body_size 1M;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $parlay_forwarded_proto;
        proxy_read_timeout 60s;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $parlay_forwarded_proto;
        expires 1h;
        add_header Cache-Control "public";
    }
}

# Cloudflare "Full" SSL mode connects to the origin on 443. Full (not strict)
# accepts a self-signed certificate, which is what this is:
#   /etc/nginx/ssl/parlaysyndicate.{crt,key}, 10-year, generated on the box.
# Browsers never see it -- they see Cloudflare's certificate.
server {
    listen 443 ssl;
    server_name parlaysyndicate.com www.parlaysyndicate.com;

    ssl_certificate     /etc/nginx/ssl/parlaysyndicate.crt;
    ssl_certificate_key /etc/nginx/ssl/parlaysyndicate.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1M;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
